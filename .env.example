# Copy with `pnpm setup`; it replaces local secret placeholders with random values.
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgresql://eventlens:replace-with-random-password@localhost:5432/eventlens
POSTGRES_USER=eventlens
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=eventlens
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
